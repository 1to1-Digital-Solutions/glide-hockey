{
  "name": "glide-hockey",
  "version": "0.26.0",
  "private": true,
  "description": "Glide Hockey: disco y mazos sobre un colchón de aire, contra la máquina. Juego web en 3D para navegador y realidad mixta (VR/AR), montable dentro de otra aplicación.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1to1-Digital-Solutions/glide-hockey.git"
  },
  "exports": {
    ".": "./src/game/index.ts",
    "./styles.css": "./src/game/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "glide-hockey-assets": "scripts/copy-assets.mjs"
  },
  "files": [
    "src/game",
    "src/components",
    "src/lib",
    "public",
    "scripts/copy-assets.mjs",
    "docs/montar-el-juego.md",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "sideEffects": [
    "*.css"
  ],
  "xrcade": {
    "capabilities": [
      "lang",
      "volumes",
      "scenery",
      "playHeight",
      "playHeightOffset",
      "grab",
      "hand"
    ],
    "budget": {
      "drawCalls": {
        "mesa": 40,
        "cartel-del-objetivo": {
          "min": 1,
          "max": 2
        }
      }
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "comunes": "python3 \"$(git rev-parse --path-format=absolute --git-common-dir)/../../organizate/scripts/repos/comunes.py\" --comprobar glide-hockey",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:xr-profiles": "node scripts/sync-xr-profiles.mjs",
    "coverage": "vitest run --coverage",
    "godot:build": "node ../xrcade/godot-kit/build.mjs --project godot",
    "godot:sfx": "node ../xrcade/godot-kit/render-sfx.mjs --project godot",
    "godot:mandos": "node ../xrcade/godot-kit/mandos.mjs --project godot",
    "godot:test": "godot/tests/run.sh"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.30",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "overrides": {
    "three": "$three"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.30",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@webxr-input-profiles/assets": "^1.0.20",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "iwer": "~2.4.0",
    "jsdom": "^30.0.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "three": "^0.185.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
